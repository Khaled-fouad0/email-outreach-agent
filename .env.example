# ============================================
# Email Outreach Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your real values
# cp .env.example .env
#
# Note: if any value is left empty, the project will
# automatically run in mock mode (no real API calls).

# --- SendGrid ---
# Get this from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# Must match your verified Sender Identity in SendGrid
SENDER_EMAIL=

# --- Groq (conversation logic - free and fast) ---
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=

# --- General settings ---
APP_ENV=development
BASE_URL=http://localhost:8002